# Copy this file to .env and fill in the values. .env is gitignored.
# build_exe.bat copies .env into Release\ next to the .exe, and launcher.py reads
# it from the .exe's own folder at start-up -- so both keys below are editable
# after a build, with no rebuild and no Python installed.

# HubSpot Private App token. Required -- the dashboard has no data without it.
HUBSPOT_TOKEN=

# Hotjar Site ID for session recording and heatmaps. Digits only, e.g. 6765855
# (Hotjar -> Settings -> Sites & Organizations).
#
# Blank or absent disables Hotjar entirely: no script is requested and no session
# is recorded. Nothing is baked into a build, so blanking this really does switch
# recording off on the next page load.
#
# NOT a secret -- it ships inside client-side JavaScript that any visitor can read.
# Keep it in this variable, not in a secret store.
HOTJAR_SITE_ID=

# Optional: fixed port for the desktop app. Omit to auto-pick a free port.
MBR_PORT=
